generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===== USERS =====
enum Role {
  USER
  ADMIN
}

model User {
  id           String    @id @default(uuid())
  employeeId   String    @unique @map("employee_id")
  email        String    @unique
  passwordHash String    @map("password_hash")
  fullName     String    @map("full_name")
  department   String?
  role         Role      @default(USER)
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  requests     Request[]

  @@map("users")
}

// ===== CATEGORIES (Admin-managed dynamic categories) =====
model Category {
  id          String      @id @default(uuid())
  name        String      @unique
  description String?
  icon        String?     // icon name identifier e.g. 'laptop', 'monitor', 'keyboard'
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  equipment   Equipment[]

  @@map("categories")
}

// ===== EQUIPMENT (Hybrid Inventory) =====
enum EquipmentStatus {
  AVAILABLE
  CHECKED_OUT
  MAINTENANCE
  RETIRED
}

model Equipment {
  id            String          @id @default(uuid())
  name          String
  description   String?
  categoryId    String          @map("category_id")
  serialNumber  String?         @unique @map("serial_number")  // Required for fixed assets
  isConsumable  Boolean         @default(false) @map("is_consumable")
  quantity      Int             @default(1)                     // Stock quantity for consumables, or 1 for fixed asset
  status        EquipmentStatus @default(AVAILABLE)
  location      String?
  imageUrl      String?         @map("image_url")
  qrCode        String?         @unique @map("qr_code")        // e.g. EQ-XXXXX
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  category      Category        @relation(fields: [categoryId], references: [id])
  requestItems  RequestItem[]

  @@map("equipment")
}

// ===== REQUESTS =====
enum RequestType {
  CHECKOUT    // ยืม (Fixed Asset)
  CONSUME     // เบิกตัดสต็อก (Consumable)
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  RETURNED
  CANCELLED
}

model Request {
  id            String        @id @default(uuid())
  requestNumber String        @unique @map("request_number") // REQ-20260907-001
  requesterId   String        @map("requester_id")
  type          RequestType
  status        RequestStatus @default(PENDING)
  reason        String?
  adminNote     String?       @map("admin_note")
  approvedAt    DateTime?     @map("approved_at")
  rejectedAt    DateTime?     @map("rejected_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  requester     User          @relation(fields: [requesterId], references: [id])
  items         RequestItem[]

  @@map("requests")
}

// ===== REQUEST ITEMS =====
model RequestItem {
  id            String    @id @default(uuid())
  requestId     String    @map("request_id")
  equipmentId   String    @map("equipment_id")
  quantity      Int       @default(1)
  checkedOutAt  DateTime? @map("checked_out_at")
  returnedAt    DateTime? @map("returned_at")
  qrScannedAt   DateTime? @map("qr_scanned_at")

  request       Request   @relation(fields: [requestId], references: [id], onDelete: Cascade)
  equipment     Equipment @relation(fields: [equipmentId], references: [id])

  @@map("request_items")
}
